{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SzymonPrajs/Tracker/schemas/benchmark-run-v1.schema.json",
  "title": "Tracker benchmark NDJSON record",
  "oneOf": [
    { "$ref": "#/$defs/run" },
    { "$ref": "#/$defs/correctness" },
    { "$ref": "#/$defs/frame" },
    { "$ref": "#/$defs/heap" },
    { "$ref": "#/$defs/telemetry" },
    { "$ref": "#/$defs/summary" }
  ],
  "$defs": {
    "common": {
      "type": "object",
      "required": ["schema_version", "type", "run_id"],
      "properties": {
        "schema_version": { "const": "benchmark-run-v1" },
        "type": { "type": "string" },
        "run_id": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "evidence_class": {
      "enum": ["host_synthetic", "device_microbenchmark", "device_pipeline"]
    },
    "timing_scope": {
      "enum": ["host_postprocess_only", "device_kernel_only", "device_pipeline"]
    },
    "run": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["evidence_class", "timing_scope", "device_fps_claim", "platform"],
          "properties": {
            "type": { "const": "run" },
            "evidence_class": { "$ref": "#/$defs/evidence_class" },
            "timing_scope": { "$ref": "#/$defs/timing_scope" },
            "device_fps_claim": { "type": "boolean" },
            "platform": { "type": "string", "minLength": 1 },
            "git_commit": { "type": ["string", "null"] },
            "git_dirty": { "type": ["boolean", "null"] },
            "firmware_sha256": { "type": ["string", "null"] },
            "model_sha256": { "type": ["string", "null"] },
            "idf_version": { "type": ["string", "null"] },
            "compiler": { "type": "string" },
            "board": { "type": ["string", "null"] },
            "chip_revision": { "type": ["string", "null"] },
            "cpu_mhz": { "type": ["number", "null"], "exclusiveMinimum": 0 },
            "camera_mode": { "type": ["string", "null"] },
            "warmup_iterations": { "type": "integer", "minimum": 0 },
            "measurement_iterations": { "type": "integer", "minimum": 1 },
            "warmup_s": { "type": "number", "minimum": 0 },
            "target_fps": { "type": "number", "exclusiveMinimum": 0 },
            "heap_tolerance_bytes": { "type": "integer", "minimum": 0 },
            "seed": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "if": { "properties": { "evidence_class": { "const": "host_synthetic" } } },
          "then": {
            "properties": {
              "timing_scope": { "const": "host_postprocess_only" },
              "device_fps_claim": { "const": false }
            }
          }
        },
        {
          "if": { "properties": { "evidence_class": { "const": "device_microbenchmark" } } },
          "then": { "properties": { "timing_scope": { "const": "device_kernel_only" } } }
        },
        {
          "if": { "properties": { "evidence_class": { "const": "device_pipeline" } } },
          "then": {
            "required": ["camera_mode", "model_sha256", "target_fps", "warmup_s"],
            "properties": {
              "timing_scope": { "const": "device_pipeline" },
              "camera_mode": { "type": "string", "minLength": 1 },
              "model_sha256": { "type": "string", "minLength": 64 },
              "warmup_s": { "type": "number", "minimum": 10 }
            }
          }
        },
        {
          "if": { "not": { "properties": { "evidence_class": { "const": "host_synthetic" } } } },
          "then": {
            "required": ["board", "chip_revision", "cpu_mhz", "firmware_sha256", "idf_version", "compiler"],
            "properties": {
              "board": { "type": "string", "minLength": 1 },
              "chip_revision": { "type": "string", "minLength": 1 },
              "firmware_sha256": { "type": "string", "minLength": 64 },
              "idf_version": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": { "properties": { "device_fps_claim": { "const": true } } },
          "then": {
            "properties": {
              "evidence_class": { "const": "device_pipeline" },
              "timing_scope": { "const": "device_pipeline" }
            }
          }
        }
      ]
    },
    "correctness": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["name", "passed"],
          "properties": {
            "type": { "const": "correctness" },
            "name": { "type": "string", "minLength": 1 },
            "passed": { "type": "boolean" },
            "expected_hash": { "type": ["string", "null"] },
            "actual_hash": { "type": ["string", "null"] },
            "detail": { "type": ["string", "null"] },
            "expected": { "type": ["object", "null"] },
            "actual": { "type": ["object", "null"] }
          }
        }
      ]
    },
    "frame": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["sequence", "csi_done_us"],
          "properties": {
            "type": { "const": "frame" },
            "sequence": { "type": "integer", "minimum": 0 },
            "buffer_id": { "type": ["integer", "null"], "minimum": 0 },
            "csi_done_us": { "type": "integer", "minimum": 0 },
            "ppa_submit_us": { "type": ["integer", "null"], "minimum": 0 },
            "ppa_done_us": { "type": ["integer", "null"], "minimum": 0 },
            "infer_start_us": { "type": ["integer", "null"], "minimum": 0 },
            "infer_done_us": { "type": ["integer", "null"], "minimum": 0 },
            "centroid_us": { "type": ["integer", "null"], "minimum": 0 },
            "actuator_us": { "type": ["integer", "null"], "minimum": 0 },
            "capture_depth": { "type": ["integer", "null"], "minimum": 0 },
            "inference_depth": { "type": ["integer", "null"], "minimum": 0 },
            "output_hash": { "type": ["string", "null"] },
            "drop_reason": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "heap": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["at_us", "caps", "free", "minimum_free", "largest"],
          "properties": {
            "type": { "const": "heap" },
            "at_us": { "type": "integer", "minimum": 0 },
            "caps": { "type": "string", "minLength": 1 },
            "free": { "type": "integer", "minimum": 0 },
            "minimum_free": { "type": "integer", "minimum": 0 },
            "largest": { "type": "integer", "minimum": 0 },
            "phase": {
              "enum": ["boot", "allocated", "post_warmup", "periodic", "final"]
            }
          }
        }
      ]
    },
    "telemetry": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["at_us", "counters"],
          "properties": {
            "type": { "const": "telemetry" },
            "at_us": { "type": "integer", "minimum": 0 },
            "counters": {
              "type": "object",
              "additionalProperties": { "type": ["integer", "number", "null"] }
            }
          }
        }
      ]
    },
    "latency": {
      "type": "object",
      "required": ["min", "mean", "p50", "p95", "p99", "max"],
      "properties": {
        "min": { "type": "number", "minimum": 0 },
        "mean": { "type": "number", "minimum": 0 },
        "p50": { "type": "number", "minimum": 0 },
        "p95": { "type": "number", "minimum": 0 },
        "p99": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "minimum": 0 }
      }
    },
    "summary": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["evidence_class", "timing_scope", "device_fps_claim", "metric", "samples"],
          "properties": {
            "type": { "const": "summary" },
            "evidence_class": { "$ref": "#/$defs/evidence_class" },
            "timing_scope": { "$ref": "#/$defs/timing_scope" },
            "device_fps_claim": { "type": "boolean" },
            "metric": { "type": "string", "minLength": 1 },
            "samples": { "type": "integer", "minimum": 0 },
            "measurement_duration_us": { "type": "number", "exclusiveMinimum": 0 },
            "measurement_start_us": { "type": "integer", "minimum": 0 },
            "measurement_end_us": { "type": "integer", "minimum": 1 },
            "latency_ns": { "$ref": "#/$defs/latency" },
            "latency_us": { "$ref": "#/$defs/latency" },
            "host_iterations_per_second": { "type": "number", "minimum": 0 },
            "captured_fps": { "type": "number", "minimum": 0 },
            "fresh_centroid_fps": { "type": "number", "minimum": 0 },
            "minimum_60s_fresh_centroid_fps": { "type": ["number", "null"], "minimum": 0 },
            "telemetry_lost": { "type": "integer", "minimum": 0 },
            "deadline_misses": { "type": "integer", "minimum": 0 },
            "max_inference_depth": { "type": "integer", "minimum": 0 },
            "drops": { "type": "object" },
            "derived_from_raw": { "type": "boolean" }
          }
        },
        {
          "if": { "properties": { "evidence_class": { "const": "host_synthetic" } } },
          "then": {
            "properties": {
              "timing_scope": { "const": "host_postprocess_only" },
              "device_fps_claim": { "const": false }
            }
          }
        },
        {
          "if": { "properties": { "device_fps_claim": { "const": true } } },
          "then": {
            "required": [
              "measurement_duration_us",
              "measurement_start_us",
              "measurement_end_us",
              "captured_fps",
              "fresh_centroid_fps",
              "minimum_60s_fresh_centroid_fps",
              "latency_us",
              "telemetry_lost",
              "max_inference_depth",
              "derived_from_raw"
            ],
            "properties": {
              "evidence_class": { "const": "device_pipeline" },
              "timing_scope": { "const": "device_pipeline" },
              "derived_from_raw": { "const": true }
            }
          }
        }
      ]
    }
  }
}
