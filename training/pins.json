{
  "schema_version": "tracker-ml-toolchain-pins-v1",
  "verified_host": {
    "os": "macOS",
    "architecture": "arm64",
    "python": "3.12"
  },
  "environments": {
    "training_and_float_export": ".tools/tracker-train",
    "esp_ppq_quantization": ".tools/tracker-quant"
  },
  "python_packages": {
    "numpy": "2.3.5",
    "pillow": "12.0.0",
    "mlx": "0.32.0",
    "torch": "2.9.0",
    "torchvision": "0.24.0",
    "onnx": "1.17.0",
    "onnxruntime": "1.28.0",
    "esp-ppq": "1.3.7",
    "pytest": "8.4.2"
  },
  "export": {
    "onnx_opset": 18,
    "batch": 1,
    "dynamic_shapes": false
  },
  "target": {
    "chip": "esp32p4",
    "esp_idf": "6.0.2",
    "esp_dl": "3.3.9",
    "default_precision": "int8"
  },
  "compatibility_notes": [
    "ESP-PPQ 1.3.7 requires ONNX >=1.14 and <1.18.",
    "The ESP-DL converter uses the legacy PyTorch ONNX exporter with dynamo disabled.",
    "MLX .mlxfn is not an ESP-PPQ interchange format; export through an equivalent PyTorch model.",
    "Training and quantization use isolated virtual environments but the same ONNX 1.17 serializer."
  ]
}
